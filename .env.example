# Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=

# Model used for plan generation. Any Groq chat model that supports JSON mode.
GROQ_MODEL=openai/gpt-oss-120b

# Set to 1 to return canned answers instead of calling Groq (local UI work, tests).
MOCK_LLM=0

# Max plan generations per IP per hour (each plan = 7 topic calls).
PLANS_PER_HOUR=5

# Contacts shown in the footer of every page. Leave empty to hide.
CONTACT_TELEGRAM=
CONTACT_EMAIL=

# --- Voice rehearsal (PassMuster), stage 0: provider check ---

# Gemini API key (https://aistudio.google.com/apikey). Needed by `npm run check:providers` and /check-providers.
GEMINI_API_KEY=

# Leave empty to call Google directly. Set only when requests must go through another address.
GEMINI_BASE_URL=

# Models for the conversation turn (text and audio input) and for the spoken questions.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_VOICE=Kore

# Turns on the page /check-providers?token=<this value>. At least 16 characters. Leave empty to keep the page off.
CHECK_TOKEN=

PORT=3000
