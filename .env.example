# Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=

# Model used for plan generation. Any Groq chat model that supports JSON mode.
GROQ_MODEL=openai/gpt-oss-120b

# Set to 1 to return canned answers instead of calling Groq (local UI work, tests).
MOCK_LLM=0

# Max plan generations per IP per hour (each plan = 7 topic calls).
PLANS_PER_HOUR=5

# Contacts shown in the footer of every page. Leave empty to hide.
CONTACT_TELEGRAM=
CONTACT_EMAIL=

# --- Voice rehearsal (PassMuster) ---

# Gemini API key (https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# Leave empty to call Google directly. Set only when requests must go through another address.
GEMINI_BASE_URL=

# Models: the conversation turn (listens to the recorded answer), the question plan, the report, the spoken questions.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_PLAN_MODEL=gemini-3.8-flash
GEMINI_REPORT_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_VOICE=Kore

# Who reads the interviewer's lines aloud: gemini, or browser (the visitor's own browser voice, no synthesis calls).
# The free Gemini tier allows 10 synthesis requests a day, so use browser until the paid tier is on.
SPEECH_PROVIDER=browser

# Who writes the text plan and reads CVs: groq (default) or gemini.
TEXT_PROVIDER=groq

# Folder for the database of access codes (one file, passmuster.db) and its daily copies. On the server: /data.
DATA_DIR=./data

# Turns on the page /check-providers?token=<this value>. At least 16 characters. Leave empty to keep the page off.
CHECK_TOKEN=

PORT=3000
