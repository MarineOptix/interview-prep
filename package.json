{
  "name": "interview-prep",
  "version": "0.1.0",
  "private": true,
  "description": "Personalised interview preparation plans for seafarers",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "test": "node --test",
    "check:providers": "node --env-file-if-exists=.env scripts/check-providers.js",
    "codes": "node --env-file-if-exists=.env scripts/codes.js"
  },
  "dependencies": {
    "marked": "^18.0.3"
  }
}
